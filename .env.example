APP_NAME=DietaIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://dietaia.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dietaia
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@dietaia.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=28
GEMINI_CACHE_TIPS_MINUTES=45

# Google OAuth (Web client ID — también se usa como audience del id_token de Android)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: Google no acepta .test — usa http://127.0.0.1:8000/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Opcional si el Client ID de Android debe aceptarse como audience adicional
GOOGLE_ANDROID_CLIENT_ID=
